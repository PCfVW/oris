.{
    // Package name in the Zig namespace. Consumers use this as the key under
    // `.dependencies` after `zig fetch --save <url>`.
    .name = .orisnitsa,

    // Semantic version. Ships in lockstep with the `orisnik` Rust crate —
    // same version number carries the same feature set and the same internal
    // state transitions (the cross-port invariant; see ../ROADMAP.md).
    .version = "0.0.0",

    // Globally unique package id, paired with `.name`. Generated by the Zig
    // toolchain; never changed once published. Do not edit by hand.
    .fingerprint = 0x154d70bd1cd10d1a,

    // Earliest supported Zig version. The std.mem.Allocator vtable shape is
    // version-sensitive, so this is load-bearing while Zig is pre-1.0.
    .minimum_zig_version = "0.16.0",

    .dependencies = .{},

    // Files included in the package hash and kept on disk by the package
    // manager. Paths are relative to this build root (the Zig/ subdirectory).
    // `include/oris.h` is a vendored, byte-identical copy of the canonical
    // `../include/oris.h` (kept in sync by c-abi-ci.yml's drift check) — the
    // top-level file itself sits outside this build root and can't be
    // referenced directly. `README.md` ships so an installed package carries
    // its own documentation, not just source.
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "include",
        "LICENSE-MIT",
        "LICENSE-APACHE",
        "README.md",
    },
}
