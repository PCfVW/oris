# Enforce LF line endings for sources so cross-platform tooling (zig fmt,
# rustfmt) agrees on every CI runner. Without this, GitHub's Windows runner
# checks files out as CRLF (core.autocrlf=true) and `zig fmt --check` fails
# even though the committed blobs are LF.
*.zig  text eol=lf
*.zon  text eol=lf
*.rs   text eol=lf
*.toml text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.h    text eol=lf
*.c    text eol=lf
*.cpp  text eol=lf
*.ps1  text eol=lf
*.sh   text eol=lf
*.py   text eol=lf
*.patch -text

# Trace corpus: the transition records are compared byte for byte across three
# implementations and three OSes, so a CRLF checkout must never touch them.
*.trace  text eol=lf
*.record text eol=lf

# Preserve the verbatim 2007 HPHA reference source exactly as vendored — no
# line-ending normalization.
Cpp/** -text
